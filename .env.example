NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Use an OpenRouter model that supports tool calling for the conversational agent.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_AGENT_MODEL=openai/gpt-6-luna
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2.5-sunburst
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=WhatsApp Sticker Agent

# WhatsApp Cloud API credentials. Use Meta's test number while developing.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v25.0

# Comma-separated WhatsApp numbers allowed to use the bot (your number and your friends' numbers, digits only, with country code).
WHATSAPP_ALLOWED_NUMBERS=

# Conversation memory (recent stickers, photos, and chat history) is kept in memory and
# expires after this many idle minutes.
MEMORY_TTL_MINUTES=15

# Maximum image generations per sender per UTC day. Failed generations are refunded.
DAILY_GENERATION_LIMIT=20

MAX_INPUT_IMAGE_BYTES=10000000

# SQLite database file. In production, keep it on a disk that survives restarts.
DATABASE_PATH=.data/sticker-agent.db
